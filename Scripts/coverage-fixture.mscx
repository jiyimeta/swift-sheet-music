            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>74</pitch>
              <tpc>16</tpc>
              <Spanner type="Glissando">
                <prev>
                  <location>
                    <measures>0</measures>
                    <fractions>-1/4</fractions>
