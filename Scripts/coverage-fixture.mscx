        <voice>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>72</pitch>
              <tpc>14</tpc>
              <Spanner type="Glissando">
                <Glissando>
                  <glissandoStyle>CHROMATIC</glissandoStyle>
