<?xml version="1.0" encoding="UTF-8"?>
<!--
  notation-coverage-fixture.mscx
  Exercises every newly-supported notation element in swift-sheet-music:
  notehead groups, small/cue notes, accidentals (all families + brackets),
  vibrato (all 4 subtypes), and glissando (straight + wavy).

  Original content authored for this repository — NOT derived from any
  MuseScore test fixture.  GPL-3.0 test-fixture files live only under
  Tests/SheetMusicTests/Resources/ (confined to the test target).
-->
<museScore version="4.60">
  <Score>
    <Division>480</Division>
    <Style>
      <spatium>1.75</spatium>
      </Style>
    <showInvisible>1</showInvisible>
    <showUnprintable>1</showUnprintable>
    <showFrames>1</showFrames>
    <showMargins>0</showMargins>
    <metaTag name="arranger"></metaTag>
    <metaTag name="composer"></metaTag>
    <metaTag name="copyright"></metaTag>
    <metaTag name="lyricist"></metaTag>
    <metaTag name="movementNumber"></metaTag>
    <metaTag name="movementTitle"></metaTag>
    <metaTag name="source"></metaTag>
    <metaTag name="translator"></metaTag>
    <metaTag name="workNumber"></metaTag>
    <metaTag name="workTitle">Notation Coverage Fixture</metaTag>
    <Part id="1">
      <Staff>
        <StaffType group="pitched">
          <name>stdNormal</name>
          </StaffType>
        </Staff>
      <trackName>Piano</trackName>
      <Instrument id="piano">
        <longName>Piano</longName>
        <shortName>Pno.</shortName>
        <trackName>Piano</trackName>
        <minPitchP>21</minPitchP>
        <maxPitchP>108</maxPitchP>
        <minPitchA>21</minPitchA>
        <maxPitchA>108</maxPitchA>
        <instrumentId>keyboard.piano</instrumentId>
        <Channel>
          <program value="0"/>
          </Channel>
        </Instrument>
      </Part>
    <Staff id="1">
      <!--
        Measure 1 — Notehead groups A: cross, xcircle, withx, plus
      -->
      <Measure>
        <voice>
          <KeySig>
            <concertKey>0</concertKey>
            </KeySig>
          <TimeSig>
            <sigN>4</sigN>
            <sigD>4</sigD>
            </TimeSig>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>64</pitch>
              <tpc>18</tpc>
              <head>cross</head>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>65</pitch>
              <tpc>13</tpc>
              <head>xcircle</head>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>67</pitch>
              <tpc>15</tpc>
              <head>withx</head>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>69</pitch>
              <tpc>17</tpc>
              <head>plus</head>
              </Note>
            </Chord>
          </voice>
        </Measure>
      <!--
        Measure 2 — Notehead groups B: diamond, slash, slashed1, triangle-up
      -->
      <Measure>
        <voice>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>71</pitch>
              <tpc>19</tpc>
              <head>diamond</head>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>72</pitch>
              <tpc>14</tpc>
              <head>slash</head>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>74</pitch>
              <tpc>16</tpc>
              <head>slashed1</head>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>76</pitch>
              <tpc>18</tpc>
              <head>triangle-up</head>
              </Note>
            </Chord>
          </voice>
        </Measure>
      <!--
        Measure 3 — Notehead groups C: triangle-down, circled, do (shape), a-name (named pitch)
      -->
      <Measure>
        <voice>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>77</pitch>
              <tpc>13</tpc>
              <head>triangle-down</head>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>79</pitch>
              <tpc>15</tpc>
              <head>circled</head>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>72</pitch>
              <tpc>14</tpc>
              <head>do</head>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>69</pitch>
              <tpc>17</tpc>
              <head>a-name</head>
              </Note>
            </Chord>
          </voice>
        </Measure>
      <!--
        Measure 4 — altbrevis notehead (whole note)
      -->
      <Measure>
        <voice>
          <Chord>
            <durationType>whole</durationType>
            <Note>
              <pitch>72</pitch>
              <tpc>14</tpc>
              <head>altbrevis</head>
              </Note>
            </Chord>
          </voice>
        </Measure>
      <!--
        Measure 5 — Small / cue notes:
          beat 1: rest
          beat 2: note-level small  (<Note><small>1</small>...)
          beat 3: chord-level small (<Chord><small>1</small>...)
          beat 4: normal note
      -->
      <Measure>
        <voice>
          <Rest>
            <durationType>quarter</durationType>
            </Rest>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <small>1</small>
              <pitch>72</pitch>
              <tpc>14</tpc>
              </Note>
            </Chord>
          <Chord>
            <small>1</small>
            <durationType>quarter</durationType>
            <Note>
              <pitch>74</pitch>
              <tpc>16</tpc>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>76</pitch>
              <tpc>18</tpc>
              </Note>
            </Chord>
          </voice>
        </Measure>
      <!--
        Measure 6 — Standard accidentals: sharp, flat, natural, doubleSharp
      -->
      <Measure>
        <voice>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>61</pitch>
              <tpc>21</tpc>
              <Accidental>
                <subtype>accidentalSharp</subtype>
                </Accidental>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>70</pitch>
              <tpc>12</tpc>
              <Accidental>
                <subtype>accidentalFlat</subtype>
                </Accidental>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>64</pitch>
              <tpc>18</tpc>
              <Accidental>
                <subtype>accidentalNatural</subtype>
                </Accidental>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>62</pitch>
              <tpc>28</tpc>
              <Accidental>
                <subtype>accidentalDoubleSharp</subtype>
                </Accidental>
              </Note>
            </Chord>
          </voice>
        </Measure>
      <!--
        Measure 7 — More accidentals: doubleFlat, quarter-tone flat (Stein),
          parenthesized (bracket=1), bracketed (bracket=2)
      -->
      <Measure>
        <voice>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>60</pitch>
              <tpc>2</tpc>
              <Accidental>
                <subtype>accidentalDoubleFlat</subtype>
                </Accidental>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>64</pitch>
              <tpc>18</tpc>
              <Accidental>
                <subtype>accidentalQuarterToneFlatStein</subtype>
                </Accidental>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>61</pitch>
              <tpc>21</tpc>
              <Accidental>
                <subtype>accidentalSharp</subtype>
                <bracket>1</bracket>
                </Accidental>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>61</pitch>
              <tpc>21</tpc>
              <Accidental>
                <subtype>accidentalSharp</subtype>
                <bracket>2</bracket>
                </Accidental>
              </Note>
            </Chord>
          </voice>
        </Measure>
      <!--
        Measure 8 — Exotic accidental (Sagittal accSagittalSharp) +
          guitarVibrato spanner over the whole measure
      -->
      <Measure>
        <voice>
          <Spanner type="Vibrato">
            <Vibrato>
              <subtype>guitarVibrato</subtype>
              </Vibrato>
            <next>
              <location>
                <measures>0</measures>
                <fractions>1/1</fractions>
                </location>
              </next>
            </Spanner>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>60</pitch>
              <tpc>14</tpc>
              <Accidental>
                <subtype>accSagittalSharp</subtype>
                </Accidental>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>62</pitch>
              <tpc>16</tpc>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>64</pitch>
              <tpc>18</tpc>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>65</pitch>
              <tpc>13</tpc>
              </Note>
            </Chord>
          <Spanner type="Vibrato">
            <prev>
              <location>
                <measures>0</measures>
                <fractions>-1/1</fractions>
                </location>
              </prev>
            </Spanner>
          </voice>
        </Measure>
      <!--
        Measure 9 — guitarVibratoWide (beats 1-2) + vibratoSawtooth (beats 3-4)
      -->
      <Measure>
        <voice>
          <Spanner type="Vibrato">
            <Vibrato>
              <subtype>guitarVibratoWide</subtype>
              </Vibrato>
            <next>
              <location>
                <measures>0</measures>
                <fractions>1/2</fractions>
                </location>
              </next>
            </Spanner>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>67</pitch>
              <tpc>15</tpc>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>69</pitch>
              <tpc>17</tpc>
              </Note>
            </Chord>
          <Spanner type="Vibrato">
            <prev>
              <location>
                <measures>0</measures>
                <fractions>-1/2</fractions>
                </location>
              </prev>
            </Spanner>
          <Spanner type="Vibrato">
            <Vibrato>
              <subtype>vibratoSawtooth</subtype>
              </Vibrato>
            <next>
              <location>
                <measures>0</measures>
                <fractions>1/2</fractions>
                </location>
              </next>
            </Spanner>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>71</pitch>
              <tpc>19</tpc>
              </Note>
            </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>72</pitch>
              <tpc>14</tpc>
              </Note>
            </Chord>
          <Spanner type="Vibrato">
            <prev>
              <location>
                <measures>0</measures>
                <fractions>-1/2</fractions>
                </location>
              </prev>
            </Spanner>
          </voice>
        </Measure>
      <!--
        Measure 10 — vibratoSawtoothWide (whole measure)
      -->
      <Measure>
        <voice>
          <Spanner type="Vibrato">
            <Vibrato>
              <subtype>vibratoSawtoothWide</subtype>
              </Vibrato>
            <next>
              <location>
                <measures>0</measures>
                <fractions>1/1</fractions>
                </location>
