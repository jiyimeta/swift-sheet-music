# Internal, point-in-time design records (specs / plans / notes). Kept
# locally for the maintainer's reference; not part of the public tree.
# Durable design decisions are distilled into ARCHITECTURE.md.
docs/superpowers/
Examples/Apple/build/

# SoundFont samples for the example app — distributed via GitHub
# Releases (too large for git). See README §"SoundFonts".
Examples/Apple/SheetMusicExample/Sounds/

# Android Gradle module
Android/.gradle/
Android/.kotlin/
Android/build/
Android/*/build/
Android/*/.cxx/
Android/local.properties

# Synced from Tests/SheetMusicTests/Resources/Golden/Audio at build time
Android/SheetMusicAudioAndroid/src/test/resources/golden/

# Cross-compiled native libs staged by Scripts/android-build-libs.sh.
# Generated artifacts, not checked in.
Android/SheetMusicAndroid/src/main/jniLibs/

# swift-java jextract-generated Java bindings, copied by
# Scripts/android-build-libs.sh from the SwiftPM plugin output.
Android/SheetMusicAndroid/src/main/java-generated/


# Subagent-driven-development scratch (ledger, briefs, review packages).
# Per-plan workspaces; never checked in.
.superpowers/

# Browser package build output. `dist/` is the wasm and its PackageToJS glue,
# regenerated by Scripts/wasm-build-web.sh; `dist-esm/` is the TypeScript
# compiler's output. The committed halves are `assets/` and `src/`.
Web/sheet-music-web/dist/
Web/sheet-music-web/dist-esm/
Web/sheet-music-web/node_modules/
Web/sheet-music-web/test-results/
Web/sheet-music-web/playwright-report/
# Playwright baselines ARE checked in — CI runs the WebAssembly job on macOS
# (the swift.org toolchain installer and Scripts/swift-org-toolchain.sh are both
# macOS-specific), so the -darwin snapshots a contributor generates are the ones
# CI compares against. A Linux runner would need its own set.
