{
  "name": "@jiyimeta/sheet-music-web",
  "version": "0.0.0",
  "description": "Browser bindings for swift-sheet-music: parse, engrave and draw notation from WebAssembly.",
  "license": "MIT",
  "type": "module",
  "main": "./dist-esm/index.js",
