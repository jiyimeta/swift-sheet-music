<museScore version="4.40">
  <Score>
    <Division>480</Division>
    <Part>
      <Staff id="1"/>
      <Instrument>
        <trackName>Test</trackName>
        <Channel>
          <program value="0"/>
        </Channel>
      </Instrument>
    </Part>
    <Staff id="1">
      <Measure>
        <voice>
          <TimeSig>
            <sigN>4</sigN>
            <sigD>4</sigD>
          </TimeSig>
          <Chord>
            <durationType>16th</durationType>
            <acciaccatura/>
            <Note>
              <pitch>59</pitch>
              <tpc>11</tpc>
            </Note>
          </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>60</pitch>
              <tpc>14</tpc>
            </Note>
          </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Note>
              <pitch>62</pitch>
              <tpc>16</tpc>
            </Note>
          </Chord>
          <!--
            A grace-type <Chord> belongs to the NEXT normal chord, both
            for before- and after-types: MuseScore buffers the whole run
            and attaches it to the following chord, splitting it by tag
            (MeasureRead::readVoice). So this <grace8after/> is a
            Nachschlag of the half note below (pitch 65), not of the
            quarter above it.
          -->
          <Chord>
            <durationType>eighth</durationType>
            <grace8after/>
            <Note>
              <pitch>64</pitch>
              <tpc>18</tpc>
            </Note>
          </Chord>
          <Chord>
            <durationType>half</durationType>
            <Note>
              <pitch>65</pitch>
              <tpc>13</tpc>
            </Note>
          </Chord>
        </voice>
      </Measure>
      <Measure>
        <voice>
          <Tuplet>
            <normalNotes>2</normalNotes>
            <actualNotes>3</actualNotes>
          </Tuplet>
          <Chord>
            <durationType>16th</durationType>
            <appoggiatura/>
            <Note>
              <pitch>67</pitch>
              <tpc>20</tpc>
            </Note>
          </Chord>
          <Chord>
            <durationType>eighth</durationType>
            <Note>
              <pitch>67</pitch>
              <tpc>20</tpc>
            </Note>
          </Chord>
          <Chord>
            <durationType>eighth</durationType>
            <Note>
              <pitch>69</pitch>
              <tpc>22</tpc>
            </Note>
          </Chord>
          <Chord>
            <durationType>eighth</durationType>
            <Note>
              <pitch>71</pitch>
              <tpc>24</tpc>
            </Note>
          </Chord>
          <endTuplet/>
          <Rest>
            <dots>1</dots>
            <durationType>half</durationType>
          </Rest>
        </voice>
      </Measure>
      <Measure>
        <voice>
          <!--
            A tied acciaccatura into its main note — the single most
            common grace-tie figure, and the case
            TieLocation.graceZeroDelta / graceIndexed exist for. `<next/>`
            / `<prev/>` are written bare here (this fixture predates the
            location fix and the decoder never reads <location> content —
            see MSCXDecoder+Note.swift); the round-trip test below only
            pins that both notes decode with tieForward/tieBack set, not
            the wire shape of <location> itself, which
            GraceTieMainNoteEncoderTests / GraceNoteEncoderTests pin
            directly.
          -->
          <Chord>
            <durationType>16th</durationType>
            <acciaccatura/>
            <Note>
              <pitch>60</pitch>
              <tpc>14</tpc>
              <Spanner type="Tie">
                <Tie/>
                <next/>
              </Spanner>
            </Note>
          </Chord>
          <Chord>
            <durationType>whole</durationType>
            <Note>
              <pitch>60</pitch>
              <tpc>14</tpc>
              <Spanner type="Tie">
                <prev/>
              </Spanner>
            </Note>
          </Chord>
        </voice>
      </Measure>
    </Staff>
  </Score>
</museScore>
